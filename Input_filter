library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity Input_filter is
    Port ( input : in SIGNED (31 downto 0);
           clk : in STD_LOGIC;
           rst : in STD_LOGIC;
           output : out UNSIGNED (31 downto 0));
end Input_filter;

architecture Behavioral of Input_filter is

type reg_array is array (7 downto 0) of signed(31 downto 0);
signal REG : reg_array;

begin

    process (clk, rst)
    begin
        if clk'event and clk = '1' then
            if rst = '1' then
                REG <= (others => (others => '0')) ;
          
            elsif input < TO_SIGNED(0, 32) then
                REG <= REG(6 downto 0) & TO_SIGNED(0, 32) ;
            else
                REG <= REG(6 downto 0) & input ;
            end if;
        end if;
    end process;
    
    output <= UNSIGNED(SHIFT_RIGHT(REG(0) + REG(1) + REG(2) + REG(3) + REG(4) + REG(5) + REG(6) + REG(7), 3)) ; 
    
end Behavioral;
